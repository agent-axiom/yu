---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/urls';

interface Props { materials: CollectionEntry<'materials'>[]; }
const { materials } = Astro.props;
const nephrite = materials.find(({ id }) => id === 'nephrite')?.data;
const jadeite = materials.find(({ id }) => id === 'jadeite')?.data;
const rows = [
  ['Минеральная семья', nephrite?.family, jadeite?.family],
  ['Химическая формула', nephrite?.chemistry, jadeite?.chemistry],
  ['Твёрдость', nephrite?.hardness, jadeite?.hardness],
  ['Структура', nephrite?.structure, jadeite?.structure],
  ['Ударная вязкость', nephrite?.toughness, jadeite?.toughness],
];
---

<material-lens class="lens" style="--lens:50%">
  <div class="lens__visual" aria-hidden="true">
    <img src={withBase('/images/jade-macro.webp')} alt="" width="1536" height="1024" loading="lazy" />
    <div class="lens__jadeite"><img src={withBase('/images/jade-macro.webp')} alt="" width="1536" height="1024" loading="lazy" /></div>
    <div class="lens__divider"></div>
    <span class="lens__label lens__label--left">Нефрит · волокна</span>
    <span class="lens__label lens__label--right">Жадеит · зёрна</span>
  </div>
  <div class="lens__control">
    <label for="material-lens-control">Передвиньте минералогическую линзу</label>
    <input id="material-lens-control" type="range" min="0" max="100" value="50" aria-valuetext="Поровну: нефрит и жадеит" />
    <p>Визуализация объясняет принцип структуры, но не служит диагностикой камня.</p>
  </div>
  <div class="comparison" role="region" aria-label="Сравнение нефрита и жадеита" tabindex="0">
    <table>
      <thead><tr><th scope="col">Свойство</th><th scope="col">Нефрит</th><th scope="col">Жадеит</th></tr></thead>
      <tbody>{rows.map((row) => <tr><th scope="row">{row[0]}</th><td>{row[1]}</td><td>{row[2]}</td></tr>)}</tbody>
    </table>
  </div>
</material-lens>

<script>
  import { clampLens } from '../lib/explorers';

  class MaterialLens extends HTMLElement {
    connectedCallback() {
      const input = this.querySelector<HTMLInputElement>('input[type="range"]');
      if (!input) return;
      const update = () => {
        const value = clampLens(Number(input.value));
        this.style.setProperty('--lens', `${value}%`);
        input.setAttribute('aria-valuetext', `${value}% нефрит, ${100 - value}% жадеит`);
      };
      input.addEventListener('input', update);
      update();
    }
  }
  customElements.define('material-lens', MaterialLens);
</script>

<style>
  .lens { display: block; }
  .lens__visual { position: relative; height: min(65vw, 39rem); min-height: 25rem; overflow: hidden; border: 1px solid var(--line); background: var(--jade-deep); }
  .lens__visual > img, .lens__jadeite, .lens__jadeite img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .lens__visual > img { filter: saturate(.72) brightness(.7); }
  .lens__jadeite { clip-path: inset(0 0 0 var(--lens)); }
  .lens__jadeite img { filter: hue-rotate(28deg) saturate(1.4) contrast(1.15) brightness(.82); transform: scaleX(-1); }
  .lens__divider { position: absolute; top: 0; bottom: 0; left: var(--lens); width: 1px; background: var(--paper); box-shadow: 0 0 1.5rem rgba(238,232,217,.8); }
  .lens__divider::after { position: absolute; top: 50%; left: 50%; display: grid; width: 3.2rem; height: 3.2rem; place-items: center; border: 1px solid var(--paper); border-radius: 50%; content: '↔'; color: var(--ink); background: var(--paper); transform: translate(-50%,-50%); }
  .lens__label { position: absolute; bottom: 1.2rem; padding: .5rem .7rem; color: var(--ink); background: rgba(238,232,217,.85); font-size: .65rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .lens__label--left { left: 1.2rem; } .lens__label--right { right: 1.2rem; }
  .lens__control { display: grid; padding: 1.5rem 0 3rem; grid-template-columns: auto minmax(12rem,1fr) auto; gap: 1.5rem; align-items: center; }
  .lens__control label { font-weight: 700; }
  .lens__control input { width: 100%; accent-color: var(--jade); }
  .lens__control p { max-width: 28ch; color: rgba(220,232,223,.52); font-size: .68rem; }
  .comparison { overflow-x: auto; }
  table { width: 100%; min-width: 48rem; border-collapse: collapse; }
  th, td { padding: 1.3rem; border: 1px solid var(--line); text-align: left; vertical-align: top; }
  thead th { color: var(--paper); font-family: var(--serif); font-size: 1.3rem; font-weight: 400; }
  thead th:not(:first-child) { color: var(--jade-bright); }
  tbody th { width: 18%; color: rgba(220,232,223,.52); font-size: .68rem; letter-spacing: .08em; text-transform: uppercase; }
  tbody td { color: rgba(220,232,223,.75); }
  @media (max-width: 760px) { .lens__control { grid-template-columns: 1fr; } .lens__visual { min-height: 20rem; } }
</style>

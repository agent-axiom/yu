---
import type { CollectionEntry } from 'astro:content';
import SourceRef from './SourceRef.astro';
import { eraPanelId } from '../lib/timeline';
import { localeFromPath, translator } from '../lib/i18n';
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);

interface Props {
  eras: CollectionEntry<'eras'>[];
  sources: CollectionEntry<'sources'>[];
}

const { eras, sources } = Astro.props;
const sourceMap = new Map(sources.map((entry) => [entry.id, entry.data]));
---

<history-timeline class="timeline">
  <div class="timeline__rail" role="tablist" aria-label={t('Исторические эпохи', 'Historical eras')}>
    <ol>
      {eras.map((era, index) => (
        <li>
          <button
            type="button"
            role="tab"
            id={`era-tab-${era.id}`}
            aria-controls={eraPanelId(era.id)}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
            data-era-index={index}
          >
            <span class="timeline__dot" aria-hidden="true"></span>
            <span class="timeline__date">{era.data.date}</span>
            <span class="timeline__name">{era.data.title}</span>
          </button>
        </li>
      ))}
    </ol>
  </div>
  <div class="timeline__panels">
    {eras.map((era, index) => (
      <article
        class="timeline__panel"
        id={eraPanelId(era.id)}
        role="tabpanel"
        aria-labelledby={`era-tab-${era.id}`}
        data-era-panel={index}
      >
        <div class="timeline__meta"><span>0{index + 1}</span><p>{era.data.place}</p></div>
        <div>
          <p class="eyebrow">{era.data.date}</p>
          <h2>{era.data.title}</h2>
          <p class="timeline__summary">{era.data.summary}</p>
          <p>{era.data.detail}</p>
          <div class="timeline__sources" aria-label={t('Источники раздела', 'Sources for this era')}>
            {era.data.citations.map((id, sourceIndex) => {
              const source = sourceMap.get(id);
              return source && <SourceRef source={source} marker={sourceIndex + 1} />;
            })}
          </div>
        </div>
      </article>
    ))}
  </div>
  <p class="timeline__hint">{t('Используйте ← →, Home и End для перемещения по шкале', 'Use ← →, Home and End to move along the timeline')}</p>
</history-timeline>

<script>
  import { nextEra } from '../lib/timeline';

  class HistoryTimeline extends HTMLElement {
    connectedCallback() {
      const tabs = [...this.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const panels = [...this.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
      if (!tabs.length || tabs.length !== panels.length) return;
      this.setAttribute('data-enhanced', '');

      const select = (index: number, focus = false) => {
        tabs.forEach((tab, tabIndex) => {
          const selected = tabIndex === index;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
          panels[tabIndex].hidden = !selected;
        });
        if (focus) tabs[index].focus();
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => select(index));
        tab.addEventListener('keydown', (event) => {
          let target = index;
          if (event.key === 'ArrowRight') target = nextEra(index, 1, tabs.length);
          else if (event.key === 'ArrowLeft') target = nextEra(index, -1, tabs.length);
          else if (event.key === 'Home') target = 0;
          else if (event.key === 'End') target = tabs.length - 1;
          else return;
          event.preventDefault();
          select(target, true);
        });
      });
      select(0);
    }
  }
  customElements.define('history-timeline', HistoryTimeline);
</script>

<style>
  .timeline { display: block; }
  .timeline__rail { overflow-x: auto; scrollbar-width: thin; }
  .timeline__rail ol { display: grid; width: max(100%, 76rem); margin: 0; padding: 0 0 2rem; grid-template-columns: repeat(8, 1fr); list-style: none; border-top: 1px solid var(--line); }
  .timeline__rail li { min-width: 0; }
  .timeline__rail button { position: relative; display: grid; width: 100%; min-height: 8rem; padding: 1.6rem .75rem .75rem; grid-template-rows: auto 1fr; gap: .4rem; border: 0; color: rgba(220,232,223,.5); background: transparent; cursor: pointer; text-align: left; transition: color .3s, background .3s; }
  .timeline__rail button:hover, .timeline__rail button[aria-selected='true'] { color: var(--paper); background: rgba(18,58,48,.35); }
  .timeline__dot { position: absolute; top: -.35rem; left: .75rem; width: .7rem; height: .7rem; border: 1px solid var(--jade); border-radius: 50%; background: var(--ink); transition: background .3s, box-shadow .3s; }
  button[aria-selected='true'] .timeline__dot { background: var(--jade); box-shadow: 0 0 1.2rem var(--jade); }
  .timeline__date { color: var(--jade); font-size: .66rem; font-weight: 700; line-height: 1.3; }
  .timeline__name { align-self: end; font-family: var(--serif); font-size: .9rem; line-height: 1.25; }
  .timeline__panels { min-height: 31rem; }
  .timeline__panel { display: grid; padding: clamp(2rem,5vw,5rem); grid-template-columns: .3fr 1fr; gap: 3rem; border: 1px solid var(--line); background: linear-gradient(135deg, rgba(18,58,48,.52), rgba(7,17,15,.8)); }
  .timeline[data-enhanced] .timeline__panel[hidden] { display: none; }
  .timeline__panel h2 { max-width: 16ch; margin: 0; color: var(--paper); font-family: var(--serif); font-size: var(--step-3); font-weight: 400; line-height: 1.08; }
  .timeline__panel p { max-width: 70ch; color: rgba(220,232,223,.7); }
  .timeline__summary { color: var(--mist) !important; font-size: var(--step-1); line-height: 1.55; }
  .timeline__meta span { color: var(--jade); font-family: var(--serif); font-size: var(--step-3); }
  .timeline__meta p { font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; }
  .timeline__sources { display: flex; gap: .5rem; margin-top: 2rem; }
  .timeline__hint { color: rgba(220,232,223,.45); font-size: .7rem; letter-spacing: .05em; }
  @media (max-width: 700px) { .timeline__panel { grid-template-columns: 1fr; gap: 1rem; } .timeline__meta { display: flex; gap: 1rem; align-items: baseline; } }
</style>

---
import { withBase } from '../lib/urls';
import { localeFromPath, translator } from '../lib/i18n';
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const source = 'https://www.metmuseum.org/art/collection/search/49371';
const chapters = [
  { number: '01', label: t('Материал', 'Material'), title: t('Не обязательно зелёный', 'Not necessarily green'), status: t('Данные каталога', 'Catalogue data'), text: t('Музей определяет материал как нефрит. На снимке он светлый, с охристыми и тёмными участками. Цвет фотографии сам по себе не позволяет определить минерал.', 'The museum identifies the material as nephrite. In the photograph it is pale, with ochre and dark areas. Colour in a photograph alone cannot identify a mineral.') },
  { number: '02', label: t('Изготовление', 'Making'), title: t('Круг — результат труда', 'A circle made through work'), status: t('Форма видна · технология требует исследования', 'Visible form · technique requires research'), text: t('Внешний контур и сквозное отверстие можно рассмотреть. Но по одному ракурсу нельзя восстановить последовательность работы или назвать инструменты этого мастера.', 'We can examine the outer contour and the hole through the centre. But a single view cannot reveal the sequence of work or identify this maker’s tools.') },
  { number: '03', label: t('Использование', 'Use'), title: t('Предмет молчит о ритуале', 'Silent about its ritual'), status: t('Интерпретация', 'Interpretation'), text: t('Met связывает подобные диски с ритуалом или высоким статусом. Это возможное объяснение, а не известная история использования именно этого bi.', 'The Met associates similar disks with ritual or high status. This is a possible interpretation, not a documented history of how this particular bi was used.') },
  { number: '04', label: t('Путь предмета', 'The object’s journey'), title: t('Здесь есть пробел', 'A gap in the record'), status: t('Не установлено по доступной карточке', 'Not established by the available record'), text: t('Место находки, первый владелец и путь до музея в доступной записи не описаны. Не будем заполнять эту паузу красивой историей.', 'The available record does not describe its findspot, first owner or route to the museum. We leave this gap open rather than fill it with a story.') },
  { number: '05', label: t('Музей', 'Museum'), title: t('Теперь у него есть номер', 'Now it has a number'), status: t('Данные каталога', 'Catalogue data'), text: t('17.118.43. The Metropolitan Museum of Art; Rogers Fund, 1917. Эта запись закрепляет музейную идентичность вещи, но не заменяет её древнюю биографию.', '17.118.43. The Metropolitan Museum of Art; Rogers Fund, 1917. This record establishes the object’s museum identity, but does not replace its ancient biography.') },
];
---

<section id="object-biography" class="object-biography section" aria-labelledby="object-title">
  <div class="page-shell">
    <header class="object-heading">
      <div><p class="eyebrow">{t('Кабинет предмета · 01', 'Object study · 01')}</p><h2 id="object-title" class="title">{t('Один диск.', 'One disk.')}<br />{t('Пять жизней.', 'Five lives.')}</h2></div>
      <p>{t('Попробуйте прочитать вещь до музейной этикетки. Сначала — поверхность и форма. Затем — то, что известно, что предполагают и о чём пока нельзя рассказать.', 'Try reading the object before its museum label. First, surface and form. Then what is known, what is inferred, and what we cannot yet tell.')}</p>
    </header>
    <div class="object-spread">
      <div class="object-sticky">
        <div data-object-explorer data-locale={locale}>
          <figure>
            <div class="object-viewport" data-object-viewport role="group" aria-label={t('Осмотр диска bi', 'Examine the bi disk')} aria-describedby="object-help">
              <img data-object-image src={withBase('/images/artifacts/liangzhu-bi.webp')} alt={t('Нефритовый диск bi: светлая пятнистая поверхность, круглое отверстие и неровность правого края', 'Nephrite bi disk with a pale mottled surface, a circular hole and an irregularity on the right edge')} width="1200" height="901" loading="lazy" draggable="false" />
              <span class="object-registration" aria-hidden="true">YU / 17.118.43</span>
            </div>
            <figcaption><span>{t('Диск bi · культура Лянчжу', 'Bi disk · Liangzhu culture')}</span><span>{t('Середина III тыс. до н. э.', 'Mid-3rd millennium BCE')}</span></figcaption>
          </figure>
          <div data-object-controls hidden>
            <div class="object-toolbar"><label for="object-zoom">{t('Ближе', 'Zoom')}</label><input id="object-zoom" data-object-zoom type="range" min="1" max="2.5" step="0.25" value="1" /><output data-object-scale for="object-zoom">1×</output><button type="button" data-object-reset aria-label={t('Показать диск целиком', 'Show the whole disk')}>{t('Целиком', 'Reset')} ↺</button></div>
            <div class="object-details" role="group" aria-label={t('Рассмотреть деталь', 'Explore a detail')}>
              <button type="button" data-object-detail data-x="49" data-y="50" aria-pressed="false">01 · {t('Отверстие', 'Opening')}</button>
              <button type="button" data-object-detail data-x="40" data-y="30" aria-pressed="false">02 · {t('Поверхность', 'Surface')}</button>
              <button type="button" data-object-detail data-x="75" data-y="50" aria-pressed="false">03 · {t('Край', 'Edge')}</button>
            </div>
            <p id="object-help" class="object-help">{t('Увеличьте и перемещайте снимок пальцем или мышью. С клавиатуры: фокус на снимке, стрелки — осмотр, Esc — целиком.', 'Zoom in and drag the photograph with a finger or mouse. Keyboard: focus the image, use arrow keys to explore, and Esc to reset.')}</p>
          </div>
          <details class="looking-notes">
            <summary>{t('На что смотреть?', 'What should I look for?')}</summary>
            <ol><li><strong>{t('Отверстие.', 'Opening.')}</strong> {t('Рассмотрите внутренний контур. Он виден, но назначение отверстия снимок не объясняет.', 'Examine the inner contour. It is visible, but the photograph does not explain the purpose of the hole.')}</li><li><strong>{t('Поверхность.', 'Surface.')}</strong> {t('Пятна и цветовые переходы — наблюдение, не диагноз состава или обработки.', 'Spots and colour transitions are observations, not a diagnosis of composition or treatment.')}</li><li><strong>{t('Край.', 'Edge.')}</strong> {t('Справа заметна неровность. Когда и как она возникла, по фотографии неизвестно.', 'An irregularity is visible on the right. The photograph cannot tell us when or how it formed.')}</li></ol>
          </details>
          <p class="object-credit"><a href={source}>{t('Карточка и фотография The Met', 'Record and photograph: The Met')} ↗</a><span>{t('Public Domain · увеличение до 2,5×', 'Public Domain · zoom up to 2.5×')}</span></p>
        </div>
      </div>
      <ol class="object-chapters">
        {chapters.map((chapter) => <li><span class="chapter-number" aria-hidden="true">{chapter.number}</span><div><p class="chapter-label">{chapter.label}</p><h3>{chapter.title}</h3><p>{chapter.text}</p><span class="chapter-status">{chapter.status}</span></div></li>)}
      </ol>
    </div>
    <p class="object-footnote">{t('Это биография с открытыми вопросами.', 'This is a biography with open questions.')} <a href={source}>{t('Каталожная запись Met', 'The Met catalogue record')}</a> {t('— опора для датировки, материала и музейных данных; наблюдения по снимку и интерпретации обозначены отдельно.', 'supports the dating, material and museum information; observations from the photograph and interpretations are labelled separately.')}</p>
  </div>
</section>

<script>
  import { bindObjectExplorer } from '../lib/object-explorer';
  document.querySelectorAll<HTMLElement>('[data-object-explorer]').forEach(bindObjectExplorer);
</script>

<style>
  .object-biography { color: var(--ink); background: var(--paper); scroll-margin-top: 2rem; }
  .object-heading { display: grid; grid-template-columns: 1fr .8fr; align-items: end; gap: 4rem; margin-bottom: 4rem; }
  .object-heading .title { color: var(--ink); }
  .object-heading .eyebrow { color: #385f50; }
  .object-heading > p { max-width: 46ch; margin: 0; color: #486155; }
  .object-spread { display: grid; grid-template-columns: minmax(0,1.1fr) minmax(0,.9fr); gap: clamp(2rem,6vw,6rem); align-items: start; }
  .object-sticky { position: sticky; top: 1.5rem; }
  figure { margin: 0; }
  .object-viewport { position: relative; overflow: hidden; background: #d5d5d3; isolation: isolate; }
  .object-viewport img { width: 100%; height: auto; transform-origin: center; user-select: none; }
  [data-zoomed='true'] .object-viewport { cursor: grab; touch-action: none; }
  [data-zoomed='true'] .object-viewport:active { cursor: grabbing; }
  .object-registration { position: absolute; top: 1rem; left: 1rem; color: #46544c; font-size: .6rem; font-weight: 700; letter-spacing: .12em; pointer-events: none; }
  figcaption { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem; padding: .85rem 0; border-bottom: 1px solid #b7bdaf; color: #395649; font-size: .7rem; }
  [hidden] { display: none !important; }
  .object-toolbar { display: flex; align-items: center; gap: .8rem; padding: .8rem 0; }
  .object-toolbar label, output { font-size: .72rem; font-weight: 700; }
  .object-toolbar input { min-width: 3rem; width: 100%; min-height: 44px; accent-color: #245d46; }
  output { min-width: 3ch; }
  button { min-height: 44px; padding: .55rem .7rem; color: #234c3b; border: 1px solid #879a89; background: transparent; cursor: pointer; font-size: .7rem; white-space: nowrap; }
  button:hover, button[aria-pressed='true'] { color: var(--paper); background: #234c3b; }
  .object-details { display: flex; flex-wrap: wrap; gap: .4rem; }
  .object-help { margin: .7rem 0; color: #526458; font-size: .66rem; line-height: 1.6; }
  .looking-notes { margin-top: .9rem; font-size: .78rem; }
  .looking-notes summary { cursor: pointer; min-height: 44px; padding-block: .6rem; color: #234c3b; font-weight: 700; }
  .looking-notes ol { padding-left: 1.2rem; color: #435b4e; }
  .looking-notes li + li { margin-top: .5rem; }
  .object-credit { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .35rem; font-size: .6rem; color: #486155; }
  .object-biography a:hover { color: #1c4935; }
  .object-chapters { list-style: none; margin: 0; padding: 0; }
  .object-chapters > li { display: grid; grid-template-columns: 2rem 1fr; gap: 1.1rem; padding: 2.2rem 0; border-top: 1px solid #b7bdaf; }
  .object-chapters > li:first-child { padding-top: 1rem; }
  .chapter-number { color: #678271; font-family: var(--serif); font-size: 1.1rem; }
  .chapter-label { margin: 0 0 .7rem; color: #4b6958; font-size: .65rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .object-chapters h3 { margin: 0; font-family: var(--serif); font-size: clamp(1.4rem,2.5vw,2rem); line-height: 1.2; font-weight: 400; }
  .object-chapters h3 + p { color: #40564a; font-size: .9rem; line-height: 1.8; }
  .chapter-status { display: inline-block; border-left: 2px solid #829880; padding-left: .6rem; color: #4d6656; font-size: .65rem; }
  .object-footnote { max-width: 80ch; margin: 3rem 0 0; color: #4d6656; font-size: .75rem; }
  @media (max-width: 820px) { .object-heading, .object-spread { grid-template-columns: 1fr; gap: 2rem; } .object-sticky { position: static; } .object-heading { margin-bottom: 2rem; } .object-chapters > li { padding: 1.7rem 0; } }
  @media (prefers-reduced-motion: reduce) { .object-viewport img { transition: none; } }
</style>

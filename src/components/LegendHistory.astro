---
import { localeFromPath, translator } from '../lib/i18n';
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const witnesses = [
  {
    id: 'hanfeizi',
    date: t('III век до н. э.*', '3rd century BCE*'),
    author: t('«Хань Фэй-цзы»', 'Han Feizi'),
    kind: t('Философская притча', 'Philosophical parable'),
    reference: t('Глава 13 · «Хэ Ши»', 'Chapter 13 · He Shi'),
    title: t('Ценность, которую не распознали', 'Value that went unrecognised'),
    storyTime: t('Древнее Чу: правления Ли, У и Вэня', 'Ancient Chu: the reigns of Li, Wu and Wen'),
    textTime: t('Поздняя эпоха Сражающихся царств', 'Late Warring States period'),
    datingNote: t('*Традиционная датировка корпуса, приписываемого Хань Фэю (ок. 280–233 до н. э.), а не точный год записи этой главы.', '*The traditional dating of the corpus attributed to Han Fei (c. 280–233 BCE), not a precise date for this chapter.'),
    datingSource: { label: t('Атрибуция корпуса · Библиотека Конгресса', 'Attribution of the corpus · Library of Congress'), url: 'https://www.loc.gov/item/2021666503/' },
    story: t('Герой находит в горах Чу необработанный камень. Два правителя доверяют оценке мастеров: это лишь камень. За мнимый обман Хэ лишают обеих стоп. При третьем правителе мастер обрабатывает находку и обнаруживает драгоценный материал. Имя человека становится именем сокровища.', 'The protagonist finds a rough stone in the mountains of Chu. Two rulers trust their craftsmen’s verdict: it is merely a stone. Accused of deception, He loses both feet. Under a third ruler, a craftsman works the find and reveals precious material. The man’s name becomes the name of the treasure.'),
    reading: t('После рассказа глава переходит к опасностям политического совета. Мы читаем здесь не просто награду за честность: даже ценное предложение может быть отвергнуто, а его автор — наказан.', 'The chapter then turns to the dangers of political advice. We read more than a reward for honesty here: even a valuable proposal may be rejected, and its author punished.'),
    boundary: t('Это свидетельство о рассказе и его политическом смысле. Оно не устанавливает место находки или минералогический состав конкретного предмета.', 'This is evidence for a story and its political meaning. It does not establish the findspot or mineral composition of a particular object.'),
    sources: [
      { label: t('«Хань Фэй-цзы», 13 · китайский текст', 'Han Feizi, 13 · Chinese text'), url: 'https://ctext.org/hanfeizi/he-shi/zh' },
      { label: t('Сверка сюжета · словарь Министерства образования Тайваня', 'Story cross-check · Taiwan Ministry of Education dictionary'), url: 'https://dict.revised.moe.edu.tw/dictView.jsp?ID=79298&q=1&word=%E5%92%8C' },
    ],
  },
  {
    id: 'shiji',
    date: t('Рубеж II–I веков до н. э.', 'Late 2nd–early 1st century BCE'),
    author: t('«Ши цзи»', 'Shiji'),
    kind: t('Историческое повествование', 'Historical narrative'),
    reference: t('Глава 81 · Лянь По и Линь Сянжу', 'Chapter 81 · Lian Po and Lin Xiangru'),
    title: t('Сокровище между двумя царствами', 'A treasure between two states'),
    storyTime: t('Эпоха Сражающихся царств: Чжао и Цинь', 'Warring States period: Zhao and Qin'),
    textTime: t('Рубеж II–I веков до н. э.', 'Late 2nd–early 1st century BCE'),
    datingNote: t('Время создания «Ши цзи» Сыма Цяня — около 100 года до н. э. Описанное посольство относится к более раннему времени.', 'Sima Qian’s Shiji was composed around 100 BCE. The diplomatic mission described took place earlier.'),
    datingSource: { label: t('Датировка труда · Oxford History of Historical Writing', 'Dating of the work · Oxford History of Historical Writing'), url: 'https://academic.oup.com/book/9284/chapter-abstract/156027551' },
    story: t('Царь Цинь предлагает Чжао пятнадцать городов за драгоценный диск Хэ Ши. Посол Линь Сянжу замечает, что обещанию нельзя доверять. Он возвращает камень себе под предлогом показать изъян, добивается отсрочки и тайно отправляет его обратно в Чжао.', 'The king of Qin offers Zhao fifteen cities for the precious He Shi disk. The envoy Lin Xiangru sees that the promise cannot be trusted. Pretending to point out a flaw, he takes back the stone, wins a delay, and secretly sends it home to Zhao.'),
    reading: t('Теперь драгоценность уже признана всеми. В нашем сопоставлении вопрос меняется: не как увидеть ценность, а как сохранить её перед лицом превосходящей силы. На первый план выходит посол.', 'The treasure’s value is now recognised by everyone. In our comparison, the question shifts: not how to recognise value, but how to preserve it against a stronger power. The envoy takes centre stage.'),
    boundary: t('Это другой эпизод о драгоценности с тем же именем, а не повтор находки Бянь Хэ. Совпадение имени не даёт непрерывной, проверенной истории самого камня.', 'This is another episode about a treasure with the same name, not a retelling of Bian He’s discovery. A shared name does not provide a continuous, verified history of the stone itself.'),
    sources: [
      { label: t('«Ши цзи», 81 · китайский текст', 'Shiji, 81 · Chinese text'), url: 'https://ctext.org/shiji/lian-po-lin-xiang-ru-lie-zhuan/zhs' },
      { label: t('Сюжет «Вернуть диск в Чжао» · Министерство образования Тайваня', 'Returning the disk to Zhao · Taiwan Ministry of Education'), url: 'https://dict.idioms.moe.edu.tw/idiomView.jsp?ID=-341&la=0&webMd=1' },
    ],
  },
  {
    id: 'retelling',
    date: t('2 марта 2015', '2 March 2015'),
    author: 'China Culture',
    kind: t('Современный пересказ', 'Modern retelling'),
    reference: 'Nine tales about Chinese jade · He Shi Bi',
    title: t('История становится уроком честности', 'The story becomes a lesson in honesty'),
    storyTime: t('Снова древнее Чу, не 2015 год', 'Ancient Chu again, not 2015'),
    textTime: t('2 марта 2015 года', '2 March 2015'),
    datingNote: t('Дата публикации этой версии на культурном портале. Она не датирует происхождение легенды.', 'The publication date of this version on the cultural portal. It does not date the origin of the legend.'),
    datingSource: { label: t('Дата и текст · China Culture', 'Date and text · China Culture'), url: 'https://en.chinaculture.org/2015-03/02/content_603183_4.htm' },
    story: t('Культурный портал возвращается к Бянь Хэ: дважды отвергнутый камень наконец раскрывает свою ценность. В финале имя драгоценности объясняется честностью героя. Рядом даётся краткое пояснение формы диска bi.', 'The cultural portal returns to Bian He: the twice-rejected stone finally reveals its value. The ending explains the treasure’s name through the protagonist’s integrity. A short explanation of the bi disk’s shape follows.'),
    reading: t('В сравнении с главой «Хань Фэй-цзы» здесь исчезает последующее рассуждение об опасности реформ. В центре короткого пересказа остаётся понятная современному читателю нравственная история.', 'Compared with the Han Feizi chapter, the subsequent discussion of the dangers of reform has disappeared. A moral story, accessible to a modern reader, remains at the centre of this brief retelling.'),
    boundary: t('Современная публикация показывает, как легенду рассказывают сегодня. Она не является независимым подтверждением событий древнего Чу.', 'This modern publication shows how the legend is retold today. It is not independent confirmation of events in ancient Chu.'),
    sources: [
      { label: t('China Culture · пересказ 2015 года', 'China Culture · 2015 retelling'), url: 'https://en.chinaculture.org/2015-03/02/content_603183_4.htm' },
    ],
  },
];
---

<section id="legend-history" class="legend-section section page-shell section-rule" aria-labelledby="legend-history-title">
  <header class="dossier-heading">
    <div>
      <p class="eyebrow">{t('История легенды · досье 01', 'History of a legend · dossier 01')}</p>
      <h2 id="legend-history-title" class="title">{t('Имя одно.', 'One name.')}<br />{t('Историй несколько.', 'Several stories.')}</h2>
    </div>
    <p>{t('Хэ Ши би', 'He Shi Bi')} — <span lang="zh">和氏璧</span>. {t('Проследим, как меняется роль драгоценности в текстах. Перед нами история рассказов, не установленная биография камня.', 'Follow the changing role of a treasure across texts. This is a history of stories, not an established biography of a stone.')}</p>
  </header>

  <legend-history class="dossier">
    <div class="witness-guide">
      <p>{t('Три текстовых свидетельства', 'Three textual witnesses')}</p>
      <span>{t('Слева направо — время текста, не событий', 'Left to right: dates of texts, not events')}</span>
    </div>
    <div class="witness-controls" data-witness-controls hidden aria-label={t('Текстовые свидетельства о Хэ Ши би', 'Textual witnesses to He Shi Bi')}>
      {witnesses.map((witness, index) => (
        <button
          type="button"
          id={`witness-${witness.id}-tab`}
          aria-controls={`witness-${witness.id}-panel`}
          data-witness-tab={witness.id}
        >
          <span class="witness-control__number" aria-hidden="true">0{index + 1}</span>
          <span class="witness-control__date">{witness.date}</span>
          <span class="witness-control__author">{witness.author}</span>
        </button>
      ))}
    </div>

    <div class="witness-pages">
      {witnesses.map((witness, index) => (
        <article
          class="witness-page"
          id={`witness-${witness.id}-panel`}
          aria-labelledby={`witness-${witness.id}-title`}
          data-witness-panel={witness.id}
        >
          <aside class="witness-margin" aria-label={t('Сведения о тексте', 'About the text')}>
            <span class="folio" aria-hidden="true">0{index + 1}<small> / 03</small></span>
            <p class="witness-kind">{witness.kind}</p>
            <p class="witness-author">{witness.author}</p>
            <p class="witness-reference">{witness.reference}</p>
            <span class="name-mark" lang="zh" aria-hidden="true">和氏璧</span>
            <p class="margin-note">{t('Имя в литературе.', 'A name in literature.')}<br />{t('Не портрет предмета.', 'Not a portrait of an object.')}</p>
          </aside>

          <div class="witness-body">
            <div class="witness-clocks">
              <div><span class="clock-label">{t('Время внутри сюжета', 'Time within the story')}</span><p>{witness.storyTime}</p></div>
              <div><span class="clock-label">{t('Время текста', 'Date of the text')}</span><p>{witness.textTime}</p></div>
            </div>
            <h3 id={`witness-${witness.id}-title`}>{witness.title}</h3>
            <p class="witness-story">{witness.story}</p>
            <div class="witness-reading">
              <h4>{t('Что меняется · наше прочтение', 'What changes · our reading')}</h4>
              <p>{witness.reading}</p>
            </div>
            <div class="witness-boundary">
              <h4>{t('Предел свидетельства', 'Limits of the evidence')}</h4>
              <p>{witness.boundary}</p>
            </div>
            <footer class="witness-sources">
              <p class="source-label">{t('Источники пересказа', 'Sources for the retelling')}</p>
              <ul>{witness.sources.map((source) => <li><a href={source.url}>{source.label} <span aria-hidden="true">↗</span></a></li>)}</ul>
              <p class="dating-note">{witness.datingNote} <a href={witness.datingSource.url}>{witness.datingSource.label} <span aria-hidden="true">↗</span></a></p>
            </footer>
          </div>
        </article>
      ))}
    </div>

    <footer class="dossier-colophon">
      <span>{t('Граница знания', 'Limits of knowledge')}</span>
      <p>{t('Тексты позволяют сравнить сюжеты, но не отождествить Хэ Ши би с сохранившимся камнем. Его превращение в императорскую печать здесь не принимается за установленный факт. Все пересказы — редакторские, не цитаты.', 'Texts let us compare stories, but not identify He Shi Bi with a surviving stone. Its transformation into an imperial seal is not treated here as established fact. All retellings are editorial paraphrases, not quotations.')}</p>
    </footer>
  </legend-history>
</section>

<script>
  import { enhanceLegendHistory } from '../lib/legend-history';

  class LegendHistory extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      this.cleanup?.();
      this.cleanup = enhanceLegendHistory(this);
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get('legend-history')) customElements.define('legend-history', LegendHistory);
</script>

<style>
  .legend-section { scroll-margin-top: 2rem; }
  .dossier-heading { display: grid; grid-template-columns: 1.05fr .95fr; align-items: end; gap: clamp(2rem, 6vw, 6rem); margin-bottom: 3rem; }
  .dossier-heading > p { max-width: 45ch; margin: 0; color: var(--mist); font-family: var(--serif); font-size: var(--step-1); line-height: 1.6; }
  .dossier { display: block; border: 1px solid var(--line); }
  .witness-guide { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 1.15rem 1.5rem; background: var(--ink-soft); }
  .witness-guide p { margin: 0; color: var(--paper); font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .witness-guide > span { color: var(--mist); font-size: .72rem; }
  .witness-controls { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); background: var(--ink-soft); }
  .witness-controls[hidden], .witness-page[hidden] { display: none; }
  .witness-controls button { position: relative; display: grid; min-height: 8rem; grid-template-columns: 2rem 1fr; gap: .25rem .6rem; align-content: center; padding: 1.2rem 1.5rem; border: 0; border-right: 1px solid var(--line); color: var(--mist); background: transparent; text-align: left; cursor: pointer; }
  .witness-controls button:last-child { border-right: 0; }
  .witness-controls button[aria-selected='true'] { color: #163b31; background: var(--paper); }
  .witness-controls button[aria-selected='true']::after { position: absolute; top: 0; left: 0; right: 0; height: 3px; background: #996846; content: ''; }
  .witness-controls button:focus-visible { z-index: 1; outline-offset: -6px; }
  .witness-control__number { grid-row: span 2; font-family: var(--serif); font-size: 1.25rem; }
  .witness-control__date { font-size: .88rem; font-weight: 700; line-height: 1.4; }
  .witness-control__author { font-size: .74rem; }
  .witness-pages { background: var(--paper); color: #273b32; }
  .witness-page { display: grid; grid-template-columns: minmax(12rem, .7fr) minmax(0, 2.3fr); border-bottom: 1px solid #bac0ac; }
  .witness-page:focus-visible { outline-color: #754d30; outline-offset: -5px; }
  .witness-margin { display: flex; flex-direction: column; align-items: flex-start; padding: clamp(1.5rem, 3vw, 3rem); border-right: 1px solid #c7c6b6; background: linear-gradient(90deg, #dcdac9, transparent 1rem); }
  .folio { margin-bottom: 2rem; color: #517060; font-family: var(--serif); font-size: 4rem; line-height: 1; }
  .folio small { font-family: var(--sans); font-size: .7rem; }
  .witness-kind { margin: 0 0 .8rem; color: #785235; font-size: .66rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .witness-author { margin: 0 0 .65rem; color: #163b31; font-family: var(--serif); font-size: 1.35rem; line-height: 1.5; }
  .witness-reference { margin: 0; color: #4b5d50; font-size: .76rem; line-height: 1.65; overflow-wrap: anywhere; }
  .name-mark { margin: 3rem 0 1rem; padding: .3rem .6rem; border: 1px solid #9b6650; color: #8b5944; font-family: serif; font-size: 2.3rem; line-height: 1.5; writing-mode: vertical-rl; }
  .margin-note { margin: 0; color: #586453; font-size: .66rem; line-height: 1.6; }
  .witness-body { min-width: 0; padding: clamp(1.5rem, 4vw, 4rem); }
  .witness-clocks { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid #b7bcaa; }
  .witness-clocks > div:last-child { padding-left: 1.5rem; border-left: 1px solid #b7bcaa; }
  .clock-label { color: #71513a; font-size: .65rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
  .witness-clocks p { margin: .4rem 0 0; color: #263d32; font-size: .8rem; line-height: 1.6; }
  .witness-body h3 { max-width: 23ch; margin: 2rem 0 1.4rem; color: #163b31; font-family: var(--serif); font-size: clamp(1.8rem, 3vw, 2.65rem); font-weight: 400; line-height: 1.2; letter-spacing: -.02em; }
  .witness-story { max-width: 65ch; margin: 0 0 2rem; color: #263b31; font-family: var(--serif); font-size: clamp(1.05rem, 1.3vw, 1.3rem); line-height: 1.8; }
  .witness-reading { margin-bottom: 1.5rem; padding-left: 1.25rem; border-left: 2px solid #6b8872; }
  .witness-body h4 { margin: 0 0 .5rem; color: #355a45; font-size: .65rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .witness-reading p, .witness-boundary p { margin: 0; font-size: .85rem; line-height: 1.75; }
  .witness-boundary { padding: 1.25rem; background: #e2dfce; }
  .witness-boundary h4 { color: #785235; }
  .witness-sources { margin-top: 2rem; border-top: 1px solid #b7bcaa; padding-top: 1rem; font-size: .7rem; line-height: 1.65; }
  .source-label { margin: 0 0 .4rem; color: #355a45; font-size: .65rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }
  .witness-sources ul { display: grid; gap: .35rem; margin: 0; padding: 0; list-style: none; }
  .witness-sources a { color: #315942; text-decoration-color: #8b9c84; }
  .witness-sources a:hover { color: #132f21; text-decoration-color: currentColor; }
  .witness-sources a:focus-visible { outline-color: #754d30; }
  .dating-note { margin: 1rem 0 0; color: #586453; }
  .dating-note a { display: inline; }
  .dossier-colophon { display: grid; grid-template-columns: minmax(9rem, .7fr) minmax(0, 2.3fr); gap: 2rem; padding: 1.5rem clamp(1.5rem, 3vw, 3rem); color: var(--mist); background: var(--ink-soft); }
  .dossier-colophon > span { color: var(--amber); font-size: .65rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .dossier-colophon p { max-width: 85ch; margin: 0; font-size: .74rem; line-height: 1.75; }
  @media (max-width: 900px) {
    .dossier-heading { grid-template-columns: 1fr; }
    .dossier-heading > p { max-width: 60ch; }
    .witness-controls button { grid-template-columns: 1fr; padding: 1rem; }
    .witness-control__number { display: none; }
    .witness-page { grid-template-columns: minmax(9rem, .6fr) minmax(0, 2fr); }
    .witness-margin { padding: 1.5rem; }
  }
  @media (max-width: 620px) {
    .witness-guide { display: block; padding-inline: 1rem; }
    .witness-guide > span { display: block; margin-top: .3rem; }
    .witness-controls button { min-height: 7.5rem; padding: 1rem .65rem; }
    .witness-control__date { font-size: .7rem; }
    .witness-control__author { font-size: .64rem; }
    .witness-page { grid-template-columns: 1fr; }
    .witness-margin { display: grid; grid-template-columns: auto 1fr; column-gap: 1rem; padding: 1.5rem; border-right: 0; border-bottom: 1px solid #c7c6b6; }
    .folio { grid-row: span 3; align-self: center; margin: 0; font-size: 2.5rem; }
    .witness-kind, .witness-author, .witness-reference { grid-column: 2; }
    .witness-kind { margin-bottom: .4rem; font-size: .6rem; }
    .witness-author { margin-bottom: .3rem; font-size: 1.15rem; }
    .name-mark, .margin-note { display: none; }
    .witness-clocks { gap: .85rem; }
    .witness-clocks > div:last-child { padding-left: .85rem; }
    .clock-label { font-size: .59rem; }
    .witness-clocks p { font-size: .73rem; }
    .dossier-colophon { grid-template-columns: 1fr; gap: .6rem; }
  }
</style>

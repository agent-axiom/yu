---
import { localeFromPath, localizePath, translator } from '../lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const href = (path: string) => localizePath(path, locale);

const items = [
  { href: '/', label: t('Главная', 'Home') },
  { href: '/history/', label: t('История', 'History') },
  { href: '/mythology/', label: t('Мифология', 'Mythology') },
  { href: '/material/', label: t('Материал', 'Material') },
  { href: '/medicine/', label: t('Медицина', 'Medicine') },
  { href: '/glossary/', label: t('Словарь', 'Glossary') },
  { href: '/sources/', label: t('Источники', 'Sources') },
];
const currentPath = Astro.url.pathname;
---

<site-navigation class="site-nav">
  <a class="brand" href={href('/')} aria-label={t('YU — на главную', 'YU — home')}>
    <span class="brand__mark" aria-hidden="true">玉</span>
    <span class="brand__name">YU</span>
    <span class="brand__descriptor">{t('живой нефрит', 'jade, in context')}</span>
  </a>
  <button class="site-nav__toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
    <span>{t('Меню', 'Menu')}</span>
    <span class="site-nav__toggle-mark" aria-hidden="true"></span>
  </button>
  <nav id="primary-navigation" class="site-nav__links" aria-label={t('Основная навигация', 'Main navigation')}>
    {items.map((item) => {
      const itemHref = href(item.href);
      const active = item.href === '/'
        ? currentPath === itemHref
        : currentPath.startsWith(itemHref);
      return <a href={itemHref} aria-current={active ? 'page' : undefined}>{item.label}</a>;
    })}
  </nav>
  <nav class="language-switch" aria-label={t('Язык сайта', 'Site language')}>
    <a href={localizePath(currentPath, 'ru')} lang="ru" hreflang="ru" aria-current={locale === 'ru' ? 'true' : undefined} data-language-link>RU<span class="language-switch__name"> — Русский</span></a>
    <span aria-hidden="true">/</span>
    <a href={localizePath(currentPath, 'en')} lang="en" hreflang="en" aria-current={locale === 'en' ? 'true' : undefined} data-language-link>EN<span class="language-switch__name"> — English</span></a>
  </nav>
</site-navigation>

<script>
  class SiteNavigation extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>('.site-nav__toggle');
      const links = this.querySelector<HTMLElement>('.site-nav__links');
      if (!button || !links) return;
      button.addEventListener('click', () => {
        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!expanded));
        links.toggleAttribute('data-open', !expanded);
      });
    }
  }
  customElements.define('site-navigation', SiteNavigation);

  const links = document.querySelectorAll<HTMLAnchorElement>('[data-language-link]');
  const syncLanguageLinks = () => links.forEach((link) => {
    const url = new URL(link.href);
    url.search = location.search;
    url.hash = location.hash;
    link.href = url.href;
  });
  syncLanguageLinks();
  window.addEventListener('hashchange', syncLanguageLinks);
</script>

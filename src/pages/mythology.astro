---
import { getCollection } from 'astro:content';
import MythExplorer from '../components/MythExplorer.astro';
import LegendHistory from '../components/LegendHistory.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Term from '../components/Term.astro';
import { withBase } from '../lib/urls';
import { localeFromPath, translator } from '../lib/i18n';
import { localizeCollection } from '../i18n/content';

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const [mythRecords, sources] = await Promise.all([getCollection('myths'), getCollection('sources')]);
const myths = localizeCollection('myths', mythRecords, locale);
const orderedMyths = myths.sort((a, b) => a.id.localeCompare(b.id));
---

<BaseLayout title={t('Мифология нефрита', 'The mythology of jade')} description={t('Легенды и культурные представления о нефрите в Китае, у майя и маори — с отделением мифа от подтверждённых данных.', 'Legends and cultural understandings of jade in China and among the Maya and Māori — with myth distinguished from evidence.')}>
  <header class="myth-hero">
    <img src={withBase('/images/mythic-jade.webp')} alt={t('Поэтическая иллюстрация круглого нефритового образа над водой и туманным ландшафтом', 'Poetic illustration of a circular jade form above water and a misty landscape')} width="1672" height="941" />
    <div aria-hidden="true"></div>
    <div class="page-shell"><p class="eyebrow">{t('Мифология · три слоя', 'Mythology · three layers')}</p><h1 class="display">{t('Камень, который научился говорить', 'The stone that learned to speak')}</h1><p class="lede">{t('Миф не ошибка в справочнике. Это язык, которым сообщества связывают материал с честностью, предками, ландшафтом, дыханием и смертью.', 'A myth is not a mistake in a reference book. It is a language through which communities connect material with honesty, ancestors, landscape, breath and death.')}</p></div>
  </header>

  <section class="section page-shell layer-key" aria-labelledby="key-title">
    <div><p class="eyebrow">{t('Как читать', 'How to read')}</p><h2 id="key-title" class="title">{t('Не разрушать историю. Не выдавать её за факт.', 'Respect the story. Do not mistake it for fact.')}</h2></div>
    <ol>
      <li><span>01</span><div><strong>{t('Легенда', 'Legend')}</strong><p>{t('Сюжет в аккуратном пересказе.', 'The story, carefully retold.')}</p></div></li>
      <li><span>02</span><div><strong>{t('Культурный контекст', 'Cultural context')}</strong><p>{t('Почему он был понятен и важен.', 'Why it made sense and why it mattered.')}</p></div></li>
      <li><span>03</span><div><strong>{t('Что подтверждено', 'What is supported')}</strong><p>{t('Предметы, тексты и границы знания.', 'Objects, texts and the limits of knowledge.')}</p></div></li>
    </ol>
  </section>

  <LegendHistory />

  <section class="section page-shell section-rule" aria-label={t('Мифологические сюжеты', 'Mythological narratives')}>
    <MythExplorer myths={orderedMyths} sources={sources} />
  </section>

  <aside class="comparison-note page-shell reveal"><p class="eyebrow">{t('Важно', 'An important distinction')}</p><p>{t('Похожие мотивы — вечность, чистота, жизнь — не доказывают общего происхождения мифов. Китайский', 'Similar motifs — eternity, purity, life — do not prove a common origin for myths. Chinese')} <Term id="yu">yù</Term>, {t('мезоамериканский', 'Mesoamerican')} <Term id="jadeite">{t('жадеит', 'jadeite')}</Term> {t('и маорийский', 'and Māori')} <Term id="pounamu">pounamu</Term> {t('принадлежат разным языкам, территориям и историческим отношениям.', 'belong to different languages, territories and historical relationships.')}</p></aside>
</BaseLayout>

<style>
  .myth-hero { position: relative; display: grid; min-height: 48rem; align-items: end; overflow: hidden; }
  .myth-hero > img, .myth-hero > div:first-of-type { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .myth-hero > div:first-of-type { background: linear-gradient(90deg, rgba(7,17,15,.92), rgba(7,17,15,.15)), linear-gradient(0deg,var(--ink),transparent 35%); }
  .myth-hero .page-shell { position: relative; padding-bottom: 6rem; }
  .myth-hero .display { max-width: 11ch; }
  .layer-key { display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; }
  .layer-key ol { margin: 0; padding: 0; list-style: none; }
  .layer-key li { display: grid; padding: 1rem 0; grid-template-columns: 3rem 1fr; border-top: 1px solid var(--line); }
  .layer-key span { color: var(--jade); font-family: var(--serif); }
  .layer-key strong { color: var(--paper); }
  .layer-key p { margin: .2rem 0; color: rgba(220,232,223,.55); }
  .comparison-note { margin-bottom: 6rem; padding: clamp(2rem,5vw,4rem); border: 1px solid var(--line); background: rgba(18,58,48,.25); }
  .comparison-note > p:last-child { max-width: 75ch; margin: 0; font-family: var(--serif); font-size: var(--step-1); }
  @media (max-width: 760px) { .layer-key { grid-template-columns: 1fr; gap: 2rem; } }
</style>

---
import { getCollection } from 'astro:content';
import MaterialLens from '../components/MaterialLens.astro';
import SourceRef from '../components/SourceRef.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
import { localeFromPath, translator } from '../lib/i18n';
import { localizeCollection } from '../i18n/content';

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const [materialRecords, sources] = await Promise.all([getCollection('materials'), getCollection('sources')]);
const materials = localizeCollection('materials', materialRecords, locale);
const sourceMap = new Map(sources.map((entry) => [entry.id, entry.data]));
const gia = sourceMap.get('gia-jade-2026');
const care = sourceMap.get('gia-care-2026');
const feng = sourceMap.get('feng-nephrite-2017');
---

<BaseLayout title={t('Нефрит и жадеит', 'Nephrite and jadeite')} description={t('Интерактивное минералогическое сравнение нефрита и жадеита: химия, структура, твёрдость, вязкость и диагностика.', 'An interactive mineralogical comparison of nephrite and jadeite: chemistry, structure, hardness, toughness and identification.')}>
  <header class="material-hero page-shell">
    <div><p class="eyebrow">{t('Материя · минералогия', 'Material · mineralogy')}</p><h1 class="display">{t('Jade — это не один камень', 'Jade is not a single stone')}</h1><p class="lede">{t('Нефрит и жадеит объединены историческим именем и выдающейся прочностью. Но микроскопически один похож на спутанный войлок, другой — на плотно собранную мозаику.', 'Nephrite and jadeite share a historical name and exceptional toughness. Under the microscope, however, one resembles tangled felt, the other a tightly fitted mosaic.')}</p></div>
    <div class="formula" aria-label={t('Химические формулы', 'Chemical formulas')}><p><span>{t('Нефрит', 'Nephrite')}</span>Ca₂(Mg,Fe)₅Si₈O₂₂(OH)₂</p><p><span>{t('Жадеит', 'Jadeite')}</span>NaAlSi₂O₆</p></div>
  </header>

  <section id="material-lens" class="section page-shell section-rule" aria-labelledby="lens-title">
    <div class="lens-head"><div><p class="eyebrow">{t('Интерактивная линза', 'Interactive lens')}</p><h2 id="lens-title" class="title">{t('Структура решает', 'Structure matters')}</h2></div><p>{t('Цвет может обмануть. Устойчивость к сколу рождается не просто из твёрдости, а из того, как кристаллы сцеплены друг с другом.', 'Colour can mislead. Resistance to chipping depends not simply on hardness, but on the way crystals interlock.')}{gia && <SourceRef source={gia} />}</p></div>
    <MaterialLens materials={materials} />
    <div class="material-properties" aria-label={t('Твёрдость и вязкость — разные свойства', 'Hardness and toughness are different properties')}>
      <div><p class="eyebrow">{t('Царапина', 'Scratching')}</p><h3>{t('Твёрдость', 'Hardness')}</h3><p>{t('Сопротивление царапанию. Шкала Мооса сравнивает, какой минерал может поцарапать другой; её ступени не равны по величине.', 'Resistance to scratching. The Mohs scale compares which mineral can scratch another; its steps are not equal in size.')}</p></div>
      <div><p class="eyebrow">{t('Скол', 'Chipping')}</p><h3>{t('Вязкость', 'Toughness')}</h3><p>{t('Сопротивление разрушению и сколам. Оба материала очень вязкие благодаря сцеплению кристаллов. Более высокая твёрдость не означает большую стойкость к удару.', 'Resistance to breaking and chipping. Both materials are very tough because their crystals interlock. Greater hardness does not mean greater resistance to impact.')}{care && <SourceRef source={care} />}</p></div>
    </div>
  </section>

  <section class="section diagnosis" aria-labelledby="diagnosis-title">
    <div class="page-shell diagnosis__grid">
      <img src={withBase('/images/jade-macro.webp')} alt={t('Генеративная макроиллюстрация зелёной волокнистой минеральной поверхности', 'AI-generated macro illustration of a green fibrous mineral surface')} width="1536" height="1024" loading="lazy" />
      <div><p class="eyebrow">{t('Подлинность', 'Authenticity')}</p><h2 id="diagnosis-title" class="title">{t('Глаз видит цвет. Лаборатория — структуру.', 'The eye sees colour. The lab sees structure.')}</h2><p class="lede">{t('Имитации, окрашивание и разные зелёные минералы делают фотографическую диагностику ненадёжной. Геммологи используют совокупность наблюдений и инструментальных методов — от оптики до спектроскопии.', 'Imitations, dyes and different green minerals make identification from photographs unreliable. Gemmologists combine observations and instrumental methods, from optics to spectroscopy.')}</p><ul><li>{t('показатель преломления и плотность;', 'refractive index and density;')}</li><li>{t('микроскопия структуры и включений;', 'microscopic examination of structure and inclusions;')}</li><li>{t('спектры Raman, FTIR и другие методы по задаче.', 'Raman and FTIR spectra, and other methods as appropriate.')}{feng && <SourceRef source={feng} />}</li></ul><p class="warning">{t('Не покупайте дорогой объект только по цвету или словам продавца: независимый лабораторный отчёт важнее «домашнего теста».', 'Do not buy an expensive object based only on colour or a seller’s claims: an independent laboratory report matters more than a ‘home test’.')}</p></div>
    </div>
  </section>
</BaseLayout>

<style>
  .material-hero { display: grid; padding-top: clamp(11rem,20vh,16rem); padding-bottom: 7rem; grid-template-columns: 1.25fr .75fr; gap: 5rem; align-items: end; }
  .material-hero .display { max-width: 11ch; }
  .formula { border-left: 1px solid var(--line); padding-left: 2rem; }
  .formula p { color: var(--paper); font-family: var(--serif); font-size: clamp(1rem,2vw,1.5rem); overflow-wrap: anywhere; }
  .formula span { display: block; margin-bottom: .4rem; color: var(--jade); font-family: var(--sans); font-size: .68rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .lens-head { display: grid; margin-bottom: 3rem; grid-template-columns: 1fr .7fr; gap: 5rem; }
  .lens-head > p { color: rgba(220,232,223,.66); }
  #material-lens { scroll-margin-top: 6rem; }
  .material-properties { display: grid; grid-template-columns: 1fr 1fr; margin-top: 2.5rem; border: 1px solid var(--line); }
  .material-properties > div { padding: clamp(1.2rem,3vw,2.5rem); }
  .material-properties > div + div { border-left: 1px solid var(--line); }
  .material-properties .eyebrow { margin-bottom: .5rem; }
  .material-properties h3 { margin: 0 0 .8rem; color: var(--paper); font-family: var(--serif); font-size: 1.8rem; font-weight: 400; }
  .material-properties p:not(.eyebrow) { margin: 0; color: rgba(220,232,223,.75); }
  .diagnosis { background: var(--paper); color: var(--ink); }
  .diagnosis__grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(2rem,8vw,8rem); align-items: center; }
  .diagnosis img { width: 100%; aspect-ratio: 4/5; object-fit: cover; }
  .diagnosis .eyebrow { color: var(--jade-deep); }
  .diagnosis .title { color: var(--ink); }
  .diagnosis .lede { color: rgba(7,17,15,.72); }
  .diagnosis li { margin: .6rem 0; }
  .warning { margin-top: 2rem; padding: 1.2rem; border-left: 3px solid #9b6d2d; background: rgba(213,168,102,.18); }
  @media (max-width: 760px) { .material-hero, .lens-head, .diagnosis__grid, .material-properties { grid-template-columns: 1fr; } .material-hero { gap: 2rem; } .formula { border-left: 0; border-top: 1px solid var(--line); padding: 1rem 0 0; } .material-properties > div + div { border-left: 0; border-top: 1px solid var(--line); } }
</style>

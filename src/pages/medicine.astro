---
import { getCollection } from 'astro:content';
import EvidencePanel from '../components/EvidencePanel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { localeFromPath, localizePath, translator } from '../lib/i18n';
import { localizeCollection } from '../i18n/content';

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const href = (path: string) => localizePath(path, locale);
const [medicineRecords, sources] = await Promise.all([getCollection('medicine'), getCollection('sources')]);
const medicine = localizeCollection('medicine', medicineRecords, locale).sort((a, b) => a.id.localeCompare(b.id));
---

<BaseLayout title={t('Нефрит и медицина', 'Jade and medicine')} description={t('Доказательная проверка лечебных утверждений о нефрите, роллерах и гуа-ша: исследования, ограничения и безопасность.', 'An evidence-based assessment of health claims about nephrite, facial rollers and gua sha: research, limitations and safety.')}>
  <header class="medicine-hero page-shell">
    <p class="eyebrow">{t('Медицина · проверка обещаний', 'Medicine · examining the claims')}</p>
    <h1 class="display">{t('Что делает камень — и что делает массаж?', 'What does the stone do — and what does massage do?')}</h1>
    <p class="lede">{t('Культурная традиция заслуживает уважения. Медицинское утверждение — отдельной проверки. Мы не переносим результат механической процедуры на «энергию» минерала.', 'Cultural traditions deserve respect. Medical claims require separate scrutiny. We do not attribute the results of a mechanical procedure to a mineral’s ‘energy’.')}</p>
  </header>

  <aside class="safety-notice page-shell" aria-label={t('Важное медицинское предупреждение', 'Important medical warning')}>
    <span aria-hidden="true">!</span>
    <div><strong>{t('Сначала безопасность', 'Safety first')}</strong><p>{t('Этот информационный материал не заменяет диагностику, консультацию квалифицированного врача и не заменяет назначенное лечение. При выраженных или сохраняющихся симптомах обратитесь за медицинской помощью.', 'This information is not a substitute for diagnosis, advice from a qualified doctor or prescribed treatment. Seek medical care for severe or persistent symptoms.')}</p></div>
  </aside>

  <section class="section page-shell section-rule evidence-key" aria-labelledby="levels-title">
    <div><p class="eyebrow">{t('Шкала чтения', 'A guide to the evidence')}</p><h2 id="levels-title" class="title">{t('Уровень — не оценка культуры', 'An evidence level is not a judgement on a culture')}</h2></div>
    <ul>
      <li><span class="key-dot key-dot--tradition"></span><strong>{t('Традиционное представление', 'Traditional belief')}</strong><p>{t('Зафиксированная практика или вера; не доказательство эффекта.', 'A documented practice or belief, not evidence of an effect.')}</p></li>
      <li><span class="key-dot key-dot--lab"></span><strong>{t('Лабораторное наблюдение', 'Laboratory observation')}</strong><p>{t('Механизм или измерение вне полноценного клинического вывода.', 'A mechanism or measurement that does not establish a clinical conclusion.')}</p></li>
      <li><span class="key-dot key-dot--clinical"></span><strong>{t('Клинические данные', 'Clinical evidence')}</strong><p>{t('Исследования на людях; качество и ограничения показаны отдельно.', 'Human studies, with quality and limitations described separately.')}</p></li>
      <li><span class="key-dot key-dot--none"></span><strong>{t('Доказательств нет', 'No evidence')}</strong><p>{t('Надёжных данных для заявленного эффекта не найдено.', 'No reliable evidence was found for the claimed effect.')}</p></li>
    </ul>
  </section>

  <section class="section page-shell claims section-rule" aria-label={t('Разбор медицинских утверждений', 'Assessment of medical claims')}>
    {medicine.map((record, index) => <EvidencePanel record={record} sources={sources} index={index} />)}
  </section>

  <section class="section page-shell limits section-rule" aria-labelledby="limits-title">
    <div><p class="eyebrow">{t('Короткий вывод', 'In brief')}</p><h2 id="limits-title" class="title">{t('Осторожный эффект процедуры не равен силе камня', 'A possible effect of massage is not a power of the stone')}</h2></div>
    <div><p class="lede">{t('Небольшие исследования допускают кратковременные изменения кровотока или отдельных параметров после массажа. Они не доказывают долговременное омоложение, лечение болезней или уникальное действие нефрита.', 'Small studies suggest short-term changes in blood flow or selected measures after massage. They do not establish lasting rejuvenation, treatment of disease or a unique effect of nephrite.')}</p><p>{t('Если вам приятен прохладный гладкий инструмент, воспринимайте его как предмет ухода, соблюдайте гигиену и умеренное давление. Для диагноза и лечения выбирайте квалифицированного специалиста, а не обещание продавца.', 'If you enjoy a cool, smooth tool, treat it as a personal-care object, keep it clean and use moderate pressure. For diagnosis and treatment, turn to a qualified professional, not a seller’s promise.')}</p><a class="button button--ghost" href={href('/sources/')}>{t('Открыть медицинские публикации', 'Read the medical publications')}</a></div>
  </section>
</BaseLayout>

<style>
  .medicine-hero { padding-top: clamp(11rem,20vh,16rem); padding-bottom: 6rem; }
  .medicine-hero .display { max-width: 13ch; }
  .safety-notice { display: grid; padding: clamp(1.5rem,4vw,3rem); grid-template-columns: 4rem 1fr; gap: 1.5rem; border: 1px solid rgba(213,168,102,.45); background: rgba(213,168,102,.08); }
  .safety-notice > span { display: grid; width: 3.2rem; height: 3.2rem; place-items: center; border: 1px solid var(--amber); border-radius: 50%; color: var(--amber); font-family: var(--serif); font-size: 1.5rem; }
  .safety-notice strong { color: var(--paper); font-size: 1.1rem; }
  .safety-notice p { max-width: 75ch; margin: .5rem 0 0; color: rgba(220,232,223,.7); }
  .evidence-key, .limits { display: grid; grid-template-columns: .75fr 1.25fr; gap: clamp(3rem,7vw,7rem); }
  .evidence-key ul { display: grid; margin: 0; padding: 0; grid-template-columns: 1fr 1fr; gap: 1px; list-style: none; background: var(--line); }
  .evidence-key li { position: relative; padding: 1.3rem; background: var(--ink); }
  .evidence-key strong { display: block; padding-left: 1.4rem; color: var(--paper); font-size: .78rem; }
  .evidence-key p { margin: .6rem 0 0; color: rgba(220,232,223,.52); font-size: .75rem; }
  .key-dot { position: absolute; top: 1.65rem; width: .7rem; height: .7rem; border-radius: 50%; background: var(--amber); }
  .key-dot--lab { background: #87aab5; } .key-dot--clinical { background: var(--jade); } .key-dot--none { background: var(--red); }
  .claims { display: grid; gap: 1px; }
  .limits > div:last-child > p:not(.lede) { color: rgba(220,232,223,.62); }
  @media (max-width: 760px) { .evidence-key, .limits { grid-template-columns: 1fr; } .evidence-key ul { grid-template-columns: 1fr; } .safety-notice { grid-template-columns: 1fr; } }
</style>

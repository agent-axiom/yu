---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localeFromPath, localizePath, translator } from '../lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const href = (path: string) => localizePath(path, locale);
const routes = [
  { href: '/history/', label: t('История', 'History') },
  { href: '/mythology/', label: t('Мифология', 'Mythology') },
  { href: '/material/', label: t('Материал', 'Material') },
  { href: '/medicine/', label: t('Медицина', 'Medicine') },
];
---

<BaseLayout title={t('Страница не найдена', 'Page not found')} description={t('Запрошенная страница проекта YU не найдена.', 'The requested YU page could not be found.')}>
  <section class="not-found page-shell">
    <div class="not-found__mark" aria-hidden="true">玉</div>
    <div>
      <p class="eyebrow">{t('Ошибка 404', 'Error 404')}</p>
      <h1 class="display">{t('Этот след обрывается', 'This trail ends here')}</h1>
      <p class="lede">{t('Камень остался, а адрес изменился или никогда не существовал. Вернитесь к началу либо выберите новый маршрут.', 'The stone remains, but this address has changed or never existed. Return to the beginning or choose another route.')}</p>
      <a class="button" href={href('/')}>{t('На главную', 'Back to home')}</a>
    </div>
    <nav aria-label={t('Основные разделы', 'Main sections')}><p>{t('Продолжить исследование', 'Keep exploring')}</p>{routes.map((route) => <a href={href(route.href)}>{route.label}<span aria-hidden="true">↗</span></a>)}</nav>
  </section>
</BaseLayout>

<style>
  .not-found { display: grid; min-height: 90vh; padding-top: 10rem; padding-bottom: 5rem; grid-template-columns: .35fr 1fr .55fr; gap: clamp(2rem,6vw,6rem); align-items: center; }
  .not-found__mark { color: rgba(143,203,165,.18); font-family: var(--serif); font-size: clamp(8rem,18vw,18rem); line-height: 1; }
  .not-found .display { max-width: 9ch; }
  .not-found nav { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .not-found nav p { color: rgba(220,232,223,.45); font-size: .67rem; letter-spacing: .09em; text-transform: uppercase; }
  .not-found nav a { display: flex; padding: .8rem 0; justify-content: space-between; border-bottom: 1px solid var(--line); color: var(--mist); text-decoration: none; }
  .not-found nav a span { color: var(--jade); }
  @media (max-width: 800px) { .not-found { grid-template-columns: 1fr; } .not-found__mark { position: absolute; z-index: -1; opacity: .5; } }
</style>
